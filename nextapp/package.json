{
  "name": "travel-booking",
  "version": "1.0.0",
  "description": "Travel Agency + Hotel Booking Management System - full-stack Next.js app",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 5173",
