    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "aws-sdk": "^2.1691.0",
    "axios": "^1.20.0",
    "bcrypt": "^5.1.1",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "next": "^16.3.3",
    "nodemailer": "^6.9.15",
    "pdfkit": "^0.15.0",
    "pg": "^8.23.0",
    "pino": "^9.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.10.1",
