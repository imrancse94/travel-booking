# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/
.pnp
.pnp.js

# Env files -- never commit real secrets
.env
.env.*
!.env.example
!*/.env.example

# Build output
dist/

# Next.js build output and dev cache
.next/
next-env.d.ts
build/
coverage/
*.tsbuildinfo

# Prisma
backend/prisma/*.db
backend/generated/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
backend/logs/*.log
!backend/logs/.gitkeep

# Local file uploads (dev-only local storage driver)
backend/uploads/

# OS files
.DS_Store
Thumbs.db

# Editor/IDE
.vscode/*
!.vscode/extensions.json
.idea/

# Test/coverage artifacts
junit.xml
.nyc_output/

# Misc
*.tmp
*.temp
.cache/
booking.pem
booking.pub
