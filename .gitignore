# Dependencies
node_modules/
nextapp/node_modules/
.pnp
.pnp.js

# Env files -- never commit real secrets
.env
.env.*
nextapp/logs/
!.env.example
!*/.env.example

# Build output
dist/

# Next.js build output and dev cache
.next/
nextapp/.next/
next-env.d.ts
build/
coverage/
*.tsbuildinfo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# All bind-mounted, stateful Docker data (postgres/redis/pgadmin/uploads) --
# see docker-compose.yml. One folder so it's obvious at a glance what's
# persisted outside the containers.
resources/

# OS files
.DS_Store
Thumbs.db

# Editor/IDE
.vscode/*
!.vscode/extensions.json
.idea/
.claude/

# Test/coverage artifacts
junit.xml
.nyc_output/

# Misc
*.tmp
*.temp
.cache/
booking.pem
booking.pub
