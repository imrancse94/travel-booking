# Copy this file to .env and adjust as needed. Never commit .env.
#
# Leave unset to use the relative default (/api/v1), which next.config.js
# rewrites to the backend. Set it only to point the browser at a different
# origin. NEXT_PUBLIC_* values are inlined at BUILD time, not read at runtime.
# NEXT_PUBLIC_API_URL=/api/v1
