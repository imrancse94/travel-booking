# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# PostgreSQL (used directly by Prisma)
DATABASE_URL=postgresql://booking_user:booking_password@postgres:5432/booking_db?schema=public

# Redis
REDIS_URL=redis://redis:6379

# JWT
JWT_SECRET=change-this-development-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-development-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Public origin of the app, used to build absolute URLs for uploaded files
# (the agency logo has to resolve from an email client, not just the browser).
# Defaults to the first CORS_ORIGIN entry when unset.
PUBLIC_URL=http://localhost:5173

# SMTP. Under `docker compose up`, EMAIL_PROVIDER/SMTP_HOST/SMTP_PORT are
# overridden to point at the bundled Mailpit service (see docker-compose.yml)
# -- view every email the app sends at http://localhost:8025, nothing is
# ever really delivered. Leave EMAIL_PROVIDER=console for a plain npm run dev
# without Docker (emails are just logged instead of sent).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Global Travel Agency <no-reply@example.com>"
EMAIL_PROVIDER=console

# Room hold configuration
BOOKING_HOLD_MINUTES=10

# File storage: local | s3
FILE_STORAGE_DRIVER=local

# AWS (only required when FILE_STORAGE_DRIVER=s3 or in production)
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Payment gateways
#
# PAYMENT_GATEWAY picks the default; a request may name another via `gateway`.
# Every provider below points at its SANDBOX host by default, so an incomplete
# deployment fails against a test endpoint rather than a live one. A gateway
# with missing credentials is refused at resolve time with a message naming
# exactly which variable is absent -- it never reaches the customer as a
# mysterious decline.
#
#   mock    always succeeds; no credentials; the default and what CI runs
#   stripe  cards, charged server-side in one call
#   paypal  buyer-approved: create order -> approve -> capture
#   bkash   buyer-approved: create -> approve -> execute   (BDT only)
#   nagad   buyer-approved: initialize -> approve -> verify (BDT only)
# ---------------------------------------------------------------------------
PAYMENT_GATEWAY=mock

# Stripe -- https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=2024-06-20
# Sandbox convenience: lets the card flow run before Stripe Elements is wired
# into the checkout form. Ignored once the browser sends a real payment method.
STRIPE_TEST_PAYMENT_METHOD=pm_card_visa

# PayPal -- https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_RETURN_URL=
PAYPAL_CANCEL_URL=

# bKash tokenized checkout -- sandbox credentials from the merchant portal
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_CALLBACK_URL=

# Nagad -- base64 keys from the merchant portal (PEM framing is added for you)
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_NUMBER=
NAGAD_MERCHANT_PRIVATE_KEY=
NAGAD_PUBLIC_KEY=
NAGAD_BASE_URL=https://api.mynagad.com/remote-payment-gateway-1.0
NAGAD_API_VERSION=v-0.2.0
NAGAD_CALLBACK_URL=

# Notification channels. `none` disables the channel; `console` uses the
# development provider that logs the message instead of sending it.
SMS_PROVIDER=none
WHATSAPP_PROVIDER=none
