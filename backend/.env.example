# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# PostgreSQL (used directly by Prisma)
DATABASE_URL=postgresql://booking_user:booking_password@postgres:5432/booking_db?schema=public

# Redis
REDIS_URL=redis://redis:6379

# JWT
JWT_SECRET=change-this-development-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-development-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# SMTP. Under `docker compose up`, EMAIL_PROVIDER/SMTP_HOST/SMTP_PORT are
# overridden to point at the bundled Mailpit service (see docker-compose.yml)
# -- view every email the app sends at http://localhost:8025, nothing is
# ever really delivered. Leave EMAIL_PROVIDER=console for a plain npm run dev
# without Docker (emails are just logged instead of sent).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Global Travel Agency <no-reply@example.com>"
EMAIL_PROVIDER=console

# Room hold configuration
BOOKING_HOLD_MINUTES=10

# File storage: local | s3
FILE_STORAGE_DRIVER=local

# AWS (only required when FILE_STORAGE_DRIVER=s3 or in production)
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Payment gateway: mock | stripe | paypal
PAYMENT_GATEWAY=mock

# Notification channels. `none` disables the channel; `console` uses the
# development provider that logs the message instead of sending it.
SMS_PROVIDER=none
WHATSAPP_PROVIDER=none
