generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================================================
// ENUMS
// ==================================================

enum HotelStatus {
  active
  inactive
  suspended
}

enum RoomStatus {
  available
  occupied
  maintenance
  inactive
}

enum RatePlanType {
  room_only
  breakfast_included
  half_board
  full_board
  all_inclusive
}

enum BookingStatus {
  pending
  held
  confirmed
  checked_in
  checked_out
  cancelled
  completed
  no_show
}

enum BookingSource {
  website
  mobile_app
  admin
  agent
  walk_in
  api
}

enum PaymentMethod {
  cash
  bank_transfer
  card
  mobile_banking
  online_gateway
}

enum PaymentStatus {
  pending
  processing
  paid
  failed
  refunded
  partially_refunded
}

enum RefundStatus {
  pending
  processing
  completed
  rejected
}

enum InvoiceStatus {
  unpaid
  partially_paid
  paid
  void
}

enum CommissionStatus {
  pending
  approved
  paid
  cancelled
}

enum TourBookingStatus {
  pending
  confirmed
  cancelled
  completed
}

enum TransportBookingStatus {
  pending
  confirmed
  in_progress
  completed
  cancelled
}

enum VehicleType {
  car
  microbus
  bus
  van
  minibus
}

enum VehicleStatus {
  available
  in_use
  maintenance
  inactive
}

enum NotificationChannel {
  email
  in_app
  sms
  whatsapp
}

enum EntityStatus {
  active
  inactive
}

// ==================================================
// IDENTITY / RBAC
// ==================================================

model Agency {
  id        String   @id @default(uuid())
  name      String
  legalName String?  @map("legal_name")
  email     String?
  phone     String?
  address   String?
  logoUrl   String?  @map("logo_url")
  currency  String   @default("USD")
  timezone  String   @default("UTC")
  status    EntityStatus @default(active)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users   User[]
  hotels  Hotel[]
  settings Setting[]

  @@map("agencies")
}

model User {
  id                  String    @id @default(uuid())
  agencyId            String?   @map("agency_id")
  firstName           String    @map("first_name")
  lastName             String   @map("last_name")
  email               String    @unique
  phone               String?
  passwordHash        String    @map("password_hash")
  isEmailVerified     Boolean   @default(false) @map("is_email_verified")
  emailVerifyToken    String?   @map("email_verify_token")
  emailVerifyExpires  DateTime? @map("email_verify_expires")
  passwordResetToken  String?   @map("password_reset_token")
  passwordResetExpires DateTime? @map("password_reset_expires")
  refreshTokenHash    String?   @map("refresh_token_hash")
  status              EntityStatus @default(active)
  lastLoginAt         DateTime? @map("last_login_at")
  deletedAt           DateTime? @map("deleted_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  agency        Agency?        @relation(fields: [agencyId], references: [id])
  userRoles     UserRole[]
  customer      Customer?
  bookingsAgent Booking[]      @relation("BookingAgent")
  commissions   Commission[]
  auditLogs     AuditLog[]
  notifications Notification[]
  checkIns      BookingRoom[]  @relation("CheckedInBy")
  checkOuts     BookingRoom[]  @relation("CheckedOutBy")
  statusChanges BookingStatusHistory[]

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  module      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ==================================================
// HOTEL / ROOM MANAGEMENT
// ==================================================

model Hotel {
  id                 String      @id @default(uuid())
  agencyId           String?     @map("agency_id")
  name               String
  description        String?
  address            String?
  city               String?
  state              String?
  country            String?
  postalCode         String?     @map("postal_code")
  latitude           Decimal?    @db.Decimal(9, 6)
  longitude          Decimal?    @db.Decimal(9, 6)
  starRating         Int?        @map("star_rating")
  email              String?
  phone              String?
  checkInTime        String      @default("14:00") @map("check_in_time")
  checkOutTime       String      @default("12:00") @map("check_out_time")
  cancellationPolicy String?     @map("cancellation_policy") @db.Text
  paymentPolicy      String?     @map("payment_policy") @db.Text
  childPolicy        String?     @map("child_policy") @db.Text
  petPolicy          String?     @map("pet_policy") @db.Text
  status             HotelStatus @default(active)
  deletedAt          DateTime?   @map("deleted_at")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  agency         Agency?         @relation(fields: [agencyId], references: [id])
  images         HotelImage[]
  hotelAmenities HotelAmenity[]
  roomTypes      RoomType[]
  bookings       Booking[]

  @@index([city, country])
  @@map("hotels")
}

model HotelImage {
  id        String   @id @default(uuid())
  hotelId   String   @map("hotel_id")
  url       String
  caption   String?
  isPrimary Boolean  @default(false) @map("is_primary")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@map("hotel_images")
}

model Amenity {
  id        String   @id @default(uuid())
  name      String   @unique
  icon      String?
  category  String?
  createdAt DateTime @default(now()) @map("created_at")

  hotelAmenities    HotelAmenity[]
  roomTypeAmenities RoomTypeAmenity[]

  @@map("amenities")
}

model HotelAmenity {
  id        String   @id @default(uuid())
  hotelId   String   @map("hotel_id")
  amenityId String   @map("amenity_id")

  hotel   Hotel   @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  amenity Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@unique([hotelId, amenityId])
  @@map("hotel_amenities")
}

model RoomType {
  id           String   @id @default(uuid())
  hotelId      String   @map("hotel_id")
  name         String
  description  String?  @db.Text
  maxAdults    Int      @default(2) @map("max_adults")
  maxChildren  Int      @default(0) @map("max_children")
  bedType      String?  @map("bed_type")
  roomSize     Decimal? @map("room_size") @db.Decimal(6, 2)
  smoking      Boolean  @default(false)
  totalRooms   Int      @default(0) @map("total_rooms")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  hotel      Hotel             @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  images     RoomTypeImage[]
  amenities  RoomTypeAmenity[]
  rooms      Room[]
  roomRates  RoomRate[]
  bookingRooms BookingRoom[]

  @@map("room_types")
}

model RoomTypeImage {
  id         String   @id @default(uuid())
  roomTypeId String   @map("room_type_id")
  url        String
  caption    String?
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@map("room_type_images")
}

model RoomTypeAmenity {
  id         String @id @default(uuid())
  roomTypeId String @map("room_type_id")
  amenityId  String @map("amenity_id")

  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  amenity  Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@unique([roomTypeId, amenityId])
  @@map("room_type_amenities")
}

model Room {
  id         String     @id @default(uuid())
  roomTypeId String     @map("room_type_id")
  roomNumber String     @map("room_number")
  floor      String?
  status     RoomStatus @default(available)
  deletedAt  DateTime?  @map("deleted_at")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  roomType     RoomType      @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  bookingRooms BookingRoom[]

  @@unique([roomTypeId, roomNumber])
  @@map("rooms")
}

// ==================================================
// PRICING
// ==================================================

model RatePlan {
  id          String       @id @default(uuid())
  name        String
  type        RatePlanType @default(room_only)
  description String?
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  roomRates RoomRate[]

  @@map("rate_plans")
}

model RoomRate {
  id               String   @id @default(uuid())
  roomTypeId       String   @map("room_type_id")
  ratePlanId       String   @map("rate_plan_id")
  startDate        DateTime @map("start_date") @db.Date
  endDate          DateTime @map("end_date") @db.Date
  price            Decimal  @db.Decimal(12, 2)
  extraAdultPrice  Decimal  @default(0) @map("extra_adult_price") @db.Decimal(12, 2)
  extraChildPrice  Decimal  @default(0) @map("extra_child_price") @db.Decimal(12, 2)
  currency         String   @default("USD")
  priority         Int      @default(0)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  ratePlan RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)

  @@index([roomTypeId, startDate, endDate])
  @@map("room_rates")
}

// ==================================================
// CUSTOMER
// ==================================================

model Customer {
  id               String   @id @default(uuid())
  userId           String?  @unique @map("user_id")
  firstName        String   @map("first_name")
  lastName         String   @map("last_name")
  email            String   @unique
  phone            String?
  address          String?
  nationality      String?
  passportNumber   String?  @map("passport_number")
  passportExpiry   DateTime? @map("passport_expiry") @db.Date
  dateOfBirth      DateTime? @map("date_of_birth") @db.Date
  deletedAt        DateTime? @map("deleted_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user        User?               @relation(fields: [userId], references: [id])
  documents   CustomerDocument[]
  bookings    Booking[]
  tourBookings TourBooking[]

  @@map("customers")
}

model CustomerDocument {
  id         String   @id @default(uuid())
  customerId String   @map("customer_id")
  type       String
  fileUrl    String   @map("file_url")
  createdAt  DateTime @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_documents")
}

// ==================================================
// SERVICES
// ==================================================

model Service {
  id          String       @id @default(uuid())
  name        String
  description String?
  price       Decimal      @db.Decimal(12, 2)
  tax         Decimal      @default(0) @db.Decimal(12, 2)
  status      EntityStatus @default(active)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  bookingServices BookingService[]

  @@map("services")
}

// ==================================================
// BOOKING
// ==================================================

model Booking {
  id               String        @id @default(uuid())
  bookingNumber    String        @unique @map("booking_number")
  hotelId          String        @map("hotel_id")
  customerId       String        @map("customer_id")
  agentId          String?       @map("agent_id")
  checkIn          DateTime      @map("check_in") @db.Date
  checkOut         DateTime      @map("check_out") @db.Date
  adults           Int           @default(1)
  children         Int           @default(0)
  specialRequests  String?       @map("special_requests") @db.Text
  status           BookingStatus @default(pending)
  source           BookingSource @default(website)
  currency         String        @default("USD")
  subtotal         Decimal       @default(0) @db.Decimal(12, 2)
  discountAmount   Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount        Decimal       @default(0) @map("tax_amount") @db.Decimal(12, 2)
  commissionAmount Decimal       @default(0) @map("commission_amount") @db.Decimal(12, 2)
  totalAmount      Decimal       @default(0) @map("total_amount") @db.Decimal(12, 2)
  paidAmount       Decimal       @default(0) @map("paid_amount") @db.Decimal(12, 2)
  dueAmount        Decimal       @default(0) @map("due_amount") @db.Decimal(12, 2)
  holdExpiresAt    DateTime?     @map("hold_expires_at")
  cancelledAt      DateTime?     @map("cancelled_at")
  cancellationFee  Decimal?      @map("cancellation_fee") @db.Decimal(12, 2)
  refundableAmount Decimal?      @map("refundable_amount") @db.Decimal(12, 2)
  cancellationReason String?     @map("cancellation_reason") @db.Text
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  hotel         Hotel                  @relation(fields: [hotelId], references: [id])
  customer      Customer               @relation(fields: [customerId], references: [id])
  agent         User?                  @relation("BookingAgent", fields: [agentId], references: [id])
  bookingRooms  BookingRoom[]
  guests        BookingGuest[]
  services      BookingService[]
  statusHistory BookingStatusHistory[]
  payments      Payment[]
  invoices      Invoice[]
  commissions   Commission[]

  @@index([status])
  @@index([checkIn, checkOut])
  @@map("bookings")
}

model BookingRoom {
  id              String    @id @default(uuid())
  bookingId       String    @map("booking_id")
  roomId          String    @map("room_id")
  roomTypeId      String    @map("room_type_id")
  checkIn         DateTime  @map("check_in") @db.Date
  checkOut        DateTime  @map("check_out") @db.Date
  nights          Int
  ratePerNight    Decimal   @map("rate_per_night") @db.Decimal(12, 2)
  totalPrice      Decimal   @map("total_price") @db.Decimal(12, 2)
  actualCheckIn   DateTime? @map("actual_check_in")
  actualCheckOut  DateTime? @map("actual_check_out")
  checkedInById   String?   @map("checked_in_by_id")
  checkedOutById  String?   @map("checked_out_by_id")
  notes           String?   @db.Text
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  booking      Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  room         Room     @relation(fields: [roomId], references: [id])
  roomType     RoomType @relation(fields: [roomTypeId], references: [id])
  checkedInBy  User?    @relation("CheckedInBy", fields: [checkedInById], references: [id])
  checkedOutBy User?    @relation("CheckedOutBy", fields: [checkedOutById], references: [id])

  @@index([roomId, checkIn, checkOut])
  @@map("booking_rooms")
}

model BookingGuest {
  id                  String    @id @default(uuid())
  bookingId           String    @map("booking_id")
  firstName           String    @map("first_name")
  lastName            String    @map("last_name")
  email               String?
  phone               String?
  dateOfBirth         DateTime? @map("date_of_birth") @db.Date
  nationality          String?
  passportNumber      String?   @map("passport_number")
  passportExpiry      DateTime? @map("passport_expiry") @db.Date
  address             String?
  specialRequirements String?   @map("special_requirements") @db.Text
  isPrimary           Boolean   @default(false) @map("is_primary")
  createdAt           DateTime  @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("booking_guests")
}

model BookingService {
  id        String   @id @default(uuid())
  bookingId String   @map("booking_id")
  serviceId String   @map("service_id")
  quantity  Int      @default(1)
  price     Decimal  @db.Decimal(12, 2)
  tax       Decimal  @default(0) @db.Decimal(12, 2)
  total     Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id])

  @@map("booking_services")
}

model BookingStatusHistory {
  id         String        @id @default(uuid())
  bookingId  String        @map("booking_id")
  fromStatus BookingStatus? @map("from_status")
  toStatus   BookingStatus @map("to_status")
  changedById String?      @map("changed_by_id")
  reason     String?       @db.Text
  createdAt  DateTime      @default(now()) @map("created_at")

  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  changedBy User?   @relation(fields: [changedById], references: [id])

  @@map("booking_status_history")
}

// ==================================================
// PAYMENTS / REFUNDS / INVOICES
// ==================================================

model Payment {
  id            String        @id @default(uuid())
  bookingId     String        @map("booking_id")
  transactionId String?       @map("transaction_id")
  amount        Decimal       @db.Decimal(12, 2)
  currency      String        @default("USD")
  method        PaymentMethod
  gateway       String?
  status        PaymentStatus @default(pending)
  paidAt        DateTime?     @map("paid_at")
  metadata      Json?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  booking Booking  @relation(fields: [bookingId], references: [id])
  refunds Refund[]

  @@map("payments")
}

model Refund {
  id        String       @id @default(uuid())
  paymentId String       @map("payment_id")
  amount    Decimal      @db.Decimal(12, 2)
  reason    String?      @db.Text
  status    RefundStatus @default(pending)
  processedAt DateTime?  @map("processed_at")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  payment Payment @relation(fields: [paymentId], references: [id])

  @@map("refunds")
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique @map("invoice_number")
  bookingId     String        @map("booking_id")
  subtotal      Decimal       @db.Decimal(12, 2)
  discountAmount Decimal      @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount     Decimal       @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount   Decimal       @map("total_amount") @db.Decimal(12, 2)
  paidAmount    Decimal       @default(0) @map("paid_amount") @db.Decimal(12, 2)
  dueAmount     Decimal       @default(0) @map("due_amount") @db.Decimal(12, 2)
  currency      String        @default("USD")
  status        InvoiceStatus @default(unpaid)
  pdfUrl        String?       @map("pdf_url")
  issuedAt      DateTime      @default(now()) @map("issued_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  booking Booking       @relation(fields: [bookingId], references: [id])
  items   InvoiceItem[]

  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String  @map("invoice_id")
  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

// ==================================================
// TRAVEL AGENCY MODULE
// ==================================================

model Destination {
  id          String       @id @default(uuid())
  name        String
  country     String?
  description String?      @db.Text
  imageUrl    String?      @map("image_url")
  status      EntityStatus @default(active)
  deletedAt   DateTime?    @map("deleted_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  tourPackages TourPackage[]

  @@map("destinations")
}

model TourPackage {
  id                String       @id @default(uuid())
  destinationId     String       @map("destination_id")
  name              String
  description       String?      @db.Text
  durationDays      Int          @map("duration_days")
  price             Decimal      @db.Decimal(12, 2)
  currency          String       @default("USD")
  maxParticipants   Int          @map("max_participants")
  includedServices  String?      @map("included_services") @db.Text
  excludedServices  String?      @map("excluded_services") @db.Text
  status            EntityStatus @default(active)
  deletedAt         DateTime?    @map("deleted_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  destination Destination      @relation(fields: [destinationId], references: [id])
  images      TourImage[]
  itineraries TourItinerary[]
  bookings    TourBooking[]

  @@map("tour_packages")
}

model TourImage {
  id            String   @id @default(uuid())
  tourPackageId String   @map("tour_package_id")
  url           String
  caption       String?
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")

  tourPackage TourPackage @relation(fields: [tourPackageId], references: [id], onDelete: Cascade)

  @@map("tour_images")
}

model TourItinerary {
  id             String  @id @default(uuid())
  tourPackageId  String  @map("tour_package_id")
  dayNumber      Int     @map("day_number")
  title          String
  description    String? @db.Text
  activities     String? @db.Text
  meals          String?
  accommodation  String?
  transportation String?

  tourPackage TourPackage @relation(fields: [tourPackageId], references: [id], onDelete: Cascade)

  @@unique([tourPackageId, dayNumber])
  @@map("tour_itineraries")
}

model TourBooking {
  id            String            @id @default(uuid())
  bookingNumber String            @unique @map("booking_number")
  tourPackageId String            @map("tour_package_id")
  customerId    String            @map("customer_id")
  participants  Int
  travelDate    DateTime          @map("travel_date") @db.Date
  price         Decimal           @db.Decimal(12, 2)
  discountAmount Decimal          @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount     Decimal           @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount   Decimal           @map("total_amount") @db.Decimal(12, 2)
  paidAmount    Decimal           @default(0) @map("paid_amount") @db.Decimal(12, 2)
  currency      String            @default("USD")
  status        TourBookingStatus @default(pending)
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  tourPackage TourPackage @relation(fields: [tourPackageId], references: [id])
  customer    Customer    @relation(fields: [customerId], references: [id])

  @@map("tour_bookings")
}

// ==================================================
// TRANSPORT
// ==================================================

model Vehicle {
  id                 String        @id @default(uuid())
  type               VehicleType
  registrationNumber String        @unique @map("registration_number")
  capacity           Int
  status             VehicleStatus @default(available)
  deletedAt          DateTime?     @map("deleted_at")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  drivers            Driver[]
  transportBookings  TransportBooking[]

  @@map("vehicles")
}

model Driver {
  id            String       @id @default(uuid())
  vehicleId     String?      @map("vehicle_id")
  name          String
  phone         String?
  licenseNumber String?      @map("license_number")
  status        EntityStatus @default(active)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  vehicle           Vehicle?           @relation(fields: [vehicleId], references: [id])
  transportBookings TransportBooking[]

  @@map("drivers")
}

model TransportBooking {
  id         String                  @id @default(uuid())
  bookingId  String?                 @map("booking_id")
  vehicleId  String                  @map("vehicle_id")
  driverId   String?                 @map("driver_id")
  pickup     String
  dropoff    String
  date       DateTime                @db.Date
  time       String
  price      Decimal                 @db.Decimal(12, 2)
  status     TransportBookingStatus  @default(pending)
  createdAt  DateTime                @default(now()) @map("created_at")
  updatedAt  DateTime                @updatedAt @map("updated_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  driver  Driver? @relation(fields: [driverId], references: [id])

  @@map("transport_bookings")
}

// ==================================================
// COMMISSION
// ==================================================

model Commission {
  id         String           @id @default(uuid())
  agentId    String           @map("agent_id")
  bookingId  String           @map("booking_id")
  percentage Decimal          @db.Decimal(5, 2)
  amount     Decimal          @db.Decimal(12, 2)
  status     CommissionStatus @default(pending)
  paidAt     DateTime?        @map("paid_at")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  agent   User    @relation(fields: [agentId], references: [id])
  booking Booking @relation(fields: [bookingId], references: [id])

  @@map("commissions")
}

// ==================================================
// NOTIFICATIONS / EMAIL
// ==================================================

model Notification {
  id        String              @id @default(uuid())
  userId    String              @map("user_id")
  channel   NotificationChannel @default(in_app)
  event     String
  title     String
  message   String              @db.Text
  isRead    Boolean             @default(false) @map("is_read")
  metadata  Json?
  createdAt DateTime            @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model EmailLog {
  id        String   @id @default(uuid())
  toEmail   String   @map("to_email")
  template  String
  subject   String
  status    String
  error     String?  @db.Text
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("email_logs")
}

// ==================================================
// AUDIT / SETTINGS
// ==================================================

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  oldValue  Json?    @map("old_value")
  newValue  Json?    @map("new_value")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@map("audit_logs")
}

model Setting {
  id        String   @id @default(uuid())
  agencyId  String?  @map("agency_id")
  key       String
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  agency Agency? @relation(fields: [agencyId], references: [id])

  @@unique([agencyId, key])
  @@map("settings")
}
